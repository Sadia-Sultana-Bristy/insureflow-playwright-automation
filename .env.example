# Copy to .env and adjust as needed. All values are optional.

# Point the suite at an already-running environment (e.g. staging).
# When unset, Playwright starts the bundled demo app on PORT automatically.
# BASE_URL=http://localhost:3000

PORT=3000

# Override the default test user (useful when running against another environment)
# TEST_USER_EMAIL=alex.morgan@insureflow.test
# TEST_USER_PASSWORD=Secure@123
